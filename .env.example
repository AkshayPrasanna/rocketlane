# ── Integration modes ────────────────────────────────────────────────────────
# Each integration runs against the real service (live) or a simulator (mock). Default: mock.
GMAIL_MODE=mock
VOICE_MODE=mock
ROCKETLANE_MODE=mock
SLACK_MODE=mock

# ── Voice call to the AE ─────────────────────────────────────────────────────
# The demo AE. The AE is identified by the verified sender address of the deal email, and the
# phone (E.164, e.g. +919876543210) is the only number the voice agent will ever dial. Real
# values belong in .env.local (gitignored), never here. Unknown senders are never called.
# AE_DEMO_EMAIL=ae@example.com
# AE_DEMO_NAME=Your Name
# AE_DEMO_PHONE=+91XXXXXXXXXX
# Total dial attempts per deal before escalating to a human (1-10).
MAX_CALL_ATTEMPTS=3
# Wait between attempts. Use a small value (e.g. 20) for demos.
CALL_RETRY_DELAY_SECONDS=900
# How long to wait for the call result webhook before polling the voice provider directly.
CALL_RESULT_TIMEOUT_SECONDS=600

# ── Onboarding plans ─────────────────────────────────────────────────────────
# Rocketlane template IDs are numeric and copied from the Rocketlane UI after you create the
# two templates (see docs/rocketlane-template-spec.md). They must differ. Required when
# ROCKETLANE_MODE=live.
# ROCKETLANE_TEMPLATE_ID_ENTERPRISE=101
# ROCKETLANE_TEMPLATE_ID_GROWTH=102
# Email of the Rocketlane user who owns every created project. Required when live.
# ROCKETLANE_OWNER_EMAIL=owner@example.com
# Display names used in the Slack welcome message (defaults live in config/onboarding-plans.ts).
# ENTERPRISE_CSM_NAME=Arjun Mehta
# GROWTH_CSM_POOL_NAME=NovaCRM Growth CS Pod
# IANA time zone that decides what "today" is for the project start date (default UTC).
# ONBOARDING_TIMEZONE=Asia/Kolkata

# ── Retries and links ────────────────────────────────────────────────────────
# Rocketlane and Slack calls that fail with a retryable error are retried this many times in
# total, with exponential backoff from the base delay.
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_SECONDS=5
# Gmail label applied to every email once it has been claimed.
# GMAIL_PROCESSED_LABEL=novacrm-onboarding/processed
# Public URL of this app, used for links in Slack ops alerts.
# APP_URL=https://your-app.vercel.app

# ── AI (email parsing) ───────────────────────────────────────────────────────
# "provider/model" string routed through Vercel AI Gateway. On Vercel it authenticates via
# OIDC; locally set AI_GATEWAY_API_KEY.
AI_MODEL=anthropic/claude-sonnet-5.5
# AI_GATEWAY_API_KEY=your-gateway-key

# ── Gmail (read by the Gmail client in Milestone 5; setup is in docs/google-cloud-setup.md) ──
# OAuth client and the refresh token for the CS inbox account. Keep real values in .env.local.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Full Pub/Sub topic name that Gmail publishes to: projects/<project-id>/topics/gmail-push
# GMAIL_PUBSUB_TOPIC=
# The push endpoint only accepts Pub/Sub requests whose signed token has this audience and
# was issued for this service account.
# GMAIL_PUSH_AUDIENCE=novacrm-gmail-push
# GMAIL_PUSH_SERVICE_ACCOUNT=gmail-push-invoker@<project-id>.iam.gserviceaccount.com

# ── Slack ────────────────────────────────────────────────────────────────────
# Bot token used when SLACK_MODE=live (needs channels:manage, channels:read, chat:write).
# SLACK_BOT_TOKEN=xoxb-your-token
# Channel ID that receives escalation alerts (e.g. C0123456789).
# OPS_SLACK_CHANNEL_ID=C0EXAMPLE
# Adds an "Open Slack" link to the admin panel.
# SLACK_WORKSPACE_URL=https://your-workspace.slack.com

# ── Storage ──────────────────────────────────────────────────────────────────
# Upstash Redis REST holds deals, the escalation queue and the audit log. Required in
# production; without it local dev falls back to a per-process in-memory store.
# Set ONE pair: UPSTASH_* (console.upstash.com) or KV_* (Vercel Marketplace). Use the
# read-write token, not KV_REST_API_READ_ONLY_TOKEN.
# UPSTASH_REDIS_REST_URL=https://your-upstash-url
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Admin panel auth (Better Auth + Slack OAuth) ─────────────────────────────
# Run `npx auth@latest migrate` after setting these. Auth sessions use Turso (or file:local.db).
BETTER_AUTH_SECRET=your-secret-min-32-chars
# BETTER_AUTH_URL=http://localhost:3000
SLACK_CLIENT_ID=your-slack-app-client-id
SLACK_CLIENT_SECRET=your-slack-app-client-secret
# Restricts sign-in to your workspace (find it in app.slack.com/client/T.../...).
SLACK_TEAM_ID=T0EXAMPLE
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Demo only: set BOTH to bypass admin sign-in (deal data is still read from the real store).
# ALLOW_ADMIN_DEMO_MODE=true
# ADMIN_DEMO_MODE=true

# ── Branding ─────────────────────────────────────────────────────────────────
# APP_NAME=NovaCRM Onboarding
