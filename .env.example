# ── Integration modes ────────────────────────────────────────────────────────
# Each integration runs against the real service (live) or a simulator (mock). Default: mock.
GMAIL_MODE=mock
VOICE_MODE=mock
ROCKETLANE_MODE=mock
SLACK_MODE=mock

# ── Voice call to the AE ─────────────────────────────────────────────────────
# Demo AE phone in E.164 (e.g. +919876543210). Never hardcoded; unknown AEs are never called.
# AE_DEMO_PHONE=+91XXXXXXXXXX
# Total dial attempts per deal before escalating to a human (1-10).
MAX_CALL_ATTEMPTS=3
# Wait between attempts. Use a small value (e.g. 20) for demos.
CALL_RETRY_DELAY_SECONDS=900
# How long to wait for the call result webhook before polling the voice provider directly.
CALL_RESULT_TIMEOUT_SECONDS=600

# ── AI (email parsing) ───────────────────────────────────────────────────────
# "provider/model" string routed through Vercel AI Gateway. On Vercel it authenticates via
# OIDC; locally set AI_GATEWAY_API_KEY.
AI_MODEL=anthropic/claude-sonnet-4-20250514
# AI_GATEWAY_API_KEY=your-gateway-key

# ── Slack ────────────────────────────────────────────────────────────────────
# Bot token used when SLACK_MODE=live (needs channels:manage, channels:read, chat:write).
# SLACK_BOT_TOKEN=xoxb-your-token
# Channel ID that receives escalation alerts (e.g. C0123456789).
# OPS_SLACK_CHANNEL_ID=C0EXAMPLE
# Adds an "Open Slack" link to the admin panel.
# SLACK_WORKSPACE_URL=https://your-workspace.slack.com

# ── Storage ──────────────────────────────────────────────────────────────────
# Upstash Redis REST holds deals, the escalation queue and the audit log. Required in
# production; without it local dev falls back to a per-process in-memory store.
# Set ONE pair: UPSTASH_* (console.upstash.com) or KV_* (Vercel Marketplace). Use the
# read-write token, not KV_REST_API_READ_ONLY_TOKEN.
# UPSTASH_REDIS_REST_URL=https://your-upstash-url
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Admin panel auth (Better Auth + Slack OAuth) ─────────────────────────────
# Run `npx auth@latest migrate` after setting these. Auth sessions use Turso (or file:local.db).
BETTER_AUTH_SECRET=your-secret-min-32-chars
# BETTER_AUTH_URL=http://localhost:3000
SLACK_CLIENT_ID=your-slack-app-client-id
SLACK_CLIENT_SECRET=your-slack-app-client-secret
# Restricts sign-in to your workspace (find it in app.slack.com/client/T.../...).
SLACK_TEAM_ID=T0EXAMPLE
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Demo only: set BOTH to bypass admin sign-in (deal data is still read from the real store).
# ALLOW_ADMIN_DEMO_MODE=true
# ADMIN_DEMO_MODE=true

# ── Branding ─────────────────────────────────────────────────────────────────
# APP_NAME=NovaCRM Onboarding
